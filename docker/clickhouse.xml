<clickhouse>
  <max_server_memory_usage>1400000000</max_server_memory_usage>
  <max_connections>64</max_connections>
  <max_concurrent_queries>8</max_concurrent_queries>
  <logger><level>warning</level><console>true</console></logger>
  <query_log remove="1"/>
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
</clickhouse>
